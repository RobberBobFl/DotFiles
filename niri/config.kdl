// Для документации и полного справочника: https://github.com/YaLTeR/niri/wiki

// ────────────── Настройка ввода ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "us,ru" // Использовать раскладку клавиатуры US и RU
	    // variant "," // 
	    options "grp:alt_shift_toggle" // Переключение раскладки Alt+Shift
        }
        numlock // Включить NumLock при старте
    }

    touchpad {
        tap // Включить тап для клика
        natural-scroll // Включить естественную прокрутку (как на macOS)
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse // Фокус на окне под курсором
    workspace-auto-back-and-forth // Переключение рабочих столов туда и обратно
}

// ────────────── Настройка вывода ──────────────
// Можно выполнить `niri msg outputs`, чтобы получить корректные имена дисплеев.
// Нужно удалить "/-" и отредактировать перед применением.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

    output "PNP(DZM) M24HVIB 0000000000000" {
    mode "1920x1080@74.973" // Установить разрешение и частоту обновления
    scale 1 // Без масштабирования (использовать 2 для HiDPI)
}	 	 	

// ────────────── Горячие клавиши ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

binds {
    MOD+SHIFT+ESCAPE                     { show-hotkey-overlay; }

    // ─── Приложения ───
    MOD+RETURN	                        hotkey-overlay-title="Открыть терминал: alacritty" { spawn-sh "alacritty"; }
    MOD+SPACE                           hotkey-overlay-title="Открыть лаунчер приложений: wofi" { spawn-sh "wofi"; }
    MOD+B                               hotkey-overlay-title="Открыть браузер: yandex" { spawn-sh "yandex-browser-corporate"; }
    MOD+ALT+L                           hotkey-overlay-title="Блокировка экрана: swaylock" { spawn-sh "swaylock"; }
    MOD+V                               hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | wofi --dmenu | cliphist decode | wl-copy"; }
    MOD+SHIFT+T                         hotkey-overlay-title="Telegram"          { spawn-sh "Telegram";}
    // Выбери свой файловый менеджер
    MOD+E                             hotkey-overlay-title="Файловый менеджер: Nautilus" { spawn-sh "nautilus"; }

    // ─── Управление звуком ───
    // Примеры назначения клавиш громкости для PipeWire & WirePlumber.
    // Свойство allow-when-locked=true делает их работающими даже при блокировке сессии.
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "playerctl previous"; }
    // Добавляю калькулятор по кнопке на клаве
    XF86Calculator {spawn "gnome-calculator";}
    

    // ─── Перемещение окон и фокус ───
    MOD+Q                               { close-window; }

    MOD+LEFT                            { focus-column-left; }
    MOD+H                               { focus-column-left; }
    MOD+RIGHT                           { focus-column-right; }
    MOD+L                               { focus-column-right; }
    MOD+UP                              { focus-window-up; }
    MOD+K                               { focus-window-up; }
    MOD+DOWN                            { focus-window-down; }
    MOD+J                               { focus-window-down; }

    MOD+CTRL+LEFT                       { move-column-left; }
    MOD+CTRL+H                          { move-column-left; }
    MOD+CTRL+RIGHT                      { move-column-right; }
    MOD+CTRL+L                          { move-column-right; }
    MOD+CTRL+UP                         { move-window-up; }
    MOD+CTRL+K                          { move-window-up; }
    MOD+CTRL+DOWN                       { move-window-down; }
    MOD+CTRL+J                          { move-window-down; }

    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }
    MOD+CTRL+HOME                       { move-column-to-first; }
    MOD+CTRL+END                        { move-column-to-last; }

    MOD+SHIFT+LEFT                      { focus-monitor-left; }
    MOD+SHIFT+RIGHT                     { focus-monitor-right; }
    MOD+SHIFT+UP                        { focus-monitor-up; }
    MOD+SHIFT+DOWN                      { focus-monitor-down; }

    MOD+SHIFT+CTRL+LEFT                 { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT                { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP                   { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN                 { move-column-to-monitor-down; }

    // ─── Переключение рабочих столов ───
    MOD+WHEELSCROLLDOWN                 cooldown-ms=150 { focus-workspace-down; }
    MOD+WHEELSCROLLUP                   cooldown-ms=150 { focus-workspace-up; }
    MOD+CTRL+WHEELSCROLLDOWN            cooldown-ms=150 { move-column-to-workspace-down; }
    MOD+CTRL+WHEELSCROLLUP              cooldown-ms=150 { move-column-to-workspace-up; }

    MOD+WHEELSCROLLRIGHT                { focus-column-right; }
    MOD+WHEELSCROLLLEFT                 { focus-column-left; }
    MOD+CTRL+WHEELSCROLLRIGHT           { move-column-right; }
    MOD+CTRL+WHEELSCROLLLEFT            { move-column-left; }

    MOD+SHIFT+WHEELSCROLLDOWN           { focus-column-right; }
    MOD+SHIFT+WHEELSCROLLUP             { focus-column-left; }
    MOD+CTRL+SHIFT+WHEELSCROLLDOWN      { move-column-right; }
    MOD+CTRL+SHIFT+WHEELSCROLLUP        { move-column-left; }

    MOD+1                               { focus-workspace 1; }
    MOD+2                               { focus-workspace 2; }
    MOD+3                               { focus-workspace 3; }
    MOD+4                               { focus-workspace 4; }
    MOD+5                               { focus-workspace 5; }
    MOD+6                               { focus-workspace 6; }
    MOD+7                               { focus-workspace 7; }
    MOD+8                               { focus-workspace 8; }
    MOD+9                               { focus-workspace 9; }

    MOD+CTRL+1                          { move-column-to-workspace 1; }
    MOD+CTRL+2                          { move-column-to-workspace 2; }
    MOD+CTRL+3                          { move-column-to-workspace 3; }
    MOD+CTRL+4                          { move-column-to-workspace 4; }
    MOD+CTRL+5                          { move-column-to-workspace 5; }
    MOD+CTRL+6                          { move-column-to-workspace 6; }
    MOD+CTRL+7                          { move-column-to-workspace 7; }
    MOD+CTRL+8                          { move-column-to-workspace 8; }
    MOD+CTRL+9                          { move-column-to-workspace 9; }

    MOD+TAB                             { focus-workspace-previous; }

    // ─── Управление компоновкой ───
    MOD+CTRL+F                          { expand-column-to-available-width; }
    MOD+C                               { center-column; }
    MOD+CTRL+C                          { center-visible-columns; }
    MOD+MINUS                           { set-column-width "-10%"; }
    MOD+EQUAL                           { set-column-width "+10%"; }
    MOD+SHIFT+MINUS                     { set-window-height "-10%"; }
    MOD+SHIFT+EQUAL                     { set-window-height "+10%"; }

    // ─── Режимы ───
    MOD+T                               { toggle-window-floating; }
    MOD+F                               { fullscreen-window; }
    MOD+W                               { toggle-column-tabbed-display; }

    // ─── Скриншоты ───
    Print                                 { screenshot; }
    CTRL+Print                            { screenshot-screen; }
    CTRL+ALT+Print                        { screenshot-window; }

    // ─── Аварийная клавиша Escape ───
    // Используйте, когда полноэкранное приложение блокирует горячие клавиши.
    // Отключает любые активные блокировки клавиатуры, восстанавливая управление.
    MOD+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Выход / Питание ───
    CTRL+ALT+DELETE                     { quit; } // Также выходит из Niri
    MOD+SHIFT+P                         { power-off-monitors; } // Выключить экраны (полезно для OLED или приватности)
    MOD+O                               repeat=false { toggle-overview; }
}

// ────────────── Автозапуск приложений ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit
    spawn-sh-at-startup "swww-daemon" // Демон обоев
    //spawn-sh-at-startup "swww img /путь/до/обоев" // Установить обои
    spawn-sh-at-startup "/home/borrow/.config/waybar/scripts/random_walpap.sh" // Рандомные обои, каждые 2 часа
    spawn-sh-at-startup "waybar" // Запустить Waybar
    spawn-sh-at-startup "v2rayn" //vpn
    spawn-sh-at-startup "/usr/lib/xdg-desktop-portal-gtk"
    spawn-sh-at-startup "/usr/lib/xdg-desktop-portal-gnome"
    spawn-sh-at-startup "wl-paste --watch cliphist store" // Копирка
    spawn-sh-at-startup "wlsunset -S 07:00 -s 20:00 -t 3500 -T 6500 -d 0" // Ночной режим(Жёлтый цвет)
    prefer-no-csd // Отключить декорации программы
    screenshot-path null // Отключить сохранение скриншотов

// ────────────── Настройки компоновки ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout

    layout {
        gaps 2 // Отступы между окнами
        center-focused-column "never" // Не центрировать автоматически фокусируемую колонку

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        focus-ring {
            width 1.5
            active-color "#b4befe"
            inactive-color "#505050"
        }

        shadow {
            softness 30
            spread 5
            offset x=0 y=5
            color "#0007"
        }

        struts {}
    }

// ────────────── Настройки анимации ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Animations
    animations {
        workspace-switch {
            spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
        }
        window-open {
            duration-ms 200
            curve "ease-out-quad"
        }
        window-close {
            duration-ms 200
            curve "ease-out-cubic"
        }
        horizontal-view-movement {
            spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 300
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
        }
    }

// ────────────── Правила окон ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

    window-rule {
        match app-id=r#"firefox$"# title="^Picture-in-Picture$"
        open-floating true // Всегда плавающее окно Firefox PiP
    }

    window-rule {
        geometry-corner-radius 4 // Установить радиус всех окон в 4
        clip-to-geometry true
    }
    // 🚀 Правило для основного окна Telegram (Плавающий и Размер 1007x696)
    window-rule {
        match app-id="org.telegram.desktop"
        open-floating true // Плавающий режим
        // Задаем желаемый размер 1007x696 пикселей
        default-column-width { fixed 1007; }
        default-window-height { fixed 696; }
    }
    // 🌐 Правило для Yandex Browser (Тайлинг, Фиксированный размер)
    window-rule {
        match app-id="Yandex-browser"
        open-maximized true
        // open-floating false // Необязательно, так как тайлинг - это режим по умолчанию
        // Задаем желаемый размер 1902x1014 пикселей.
        // В режиме тайлинга niri будет пытаться применить этот размер как
        // предпочтительный для колонки или окна.
        //default-column-width {proportion 1.0;}
        // default-window-height { fixed 1014; }
    }
    // 🎧 Правило для Pavucontrol (Фиксированный размер и позиция)
    window-rule {
        match app-id="org.pulseaudio.pavucontrol"  
        open-floating true // Активируем плавающий режим  
        // Задаем точный размер 452x685 пикселей
        default-column-width { fixed 452; }
        default-window-height { fixed 685; }
        // Устанавливаем позицию 1424, 47 относительно верхнего левого угла экрана
        default-floating-position x=32 y=32 relative-to="bottom-right"
        }
        
    // 🎧 Правило для календаря (Фиксированный размер и позиция)
    window-rule {
        match app-id="org.gnome.Calendar"
        open-floating true // Активируем плавающий режим
        // Задаем точный размер 437x600 пикселей
        default-column-width { fixed 437; }
        default-window-height { fixed 600; }
        // Устанавливаем позицию 1424, 47 относительно нижнего правого угла экрана
        default-floating-position x=32 y=32 relative-to="bottom-right"
        }
        
     // 🎧 Правило для блютуза (Фиксированный размер и позиция)
        window-rule {
            match app-id="blueman-manager"
            open-floating true // Активируем плавающий режим
            // Задаем точный размер 437x600 пикселей
            default-column-width { fixed 545; }
            default-window-height { fixed 307; }  
            // Устанавливаем позицию 1424, 47 относительно нижнего правого угла экрана
            default-floating-position x=32 y=32 relative-to="bottom-right"
            }   
        

// ────────────── Переменные окружения ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#environment

    environment {
        //DISPLAY ":1"
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_SESSION_TYPE "wayland"
        XDG_CURRENT_DESKTOP "niri"
        TERMINAL "Alacritty"
    }

    hotkey-overlay {
        skip-at-startup
    }
